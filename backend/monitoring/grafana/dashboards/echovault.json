{
  "title": "EchoVault Backend",
  "uid": "echovault-backend",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"echovault-backend\"}[1m])) by (handler)",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 2,
      "title": "P95 Request Latency",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"echovault-backend\"}[1m])) by (handler, le))",
          "legendFormat": "p95 {{handler}}"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"echovault-backend\"}[1m])) by (handler, le))",
          "legendFormat": "p50 {{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"echovault-backend\", status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "fixedColor": "red", "mode": "fixed" } }
      }
    },
    {
      "id": 4,
      "title": "Cards Generated (rate)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(echovault_cards_generated_total{job=\"echovault-backend\"}[5m])",
          "legendFormat": "{{card_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 5,
      "title": "LLM Call Duration (P95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(echovault_llm_duration_seconds_bucket{job=\"echovault-backend\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(echovault_llm_duration_seconds_bucket{job=\"echovault-backend\"}[5m])) by (le))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 6,
      "title": "Batch File Size Distribution",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(echovault_batch_files_bucket{job=\"echovault-backend\"}[5m])) by (le))",
          "legendFormat": "p95 files/batch"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 7,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 24, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "http_requests_in_progress{job=\"echovault-backend\"}",
          "legendFormat": "in progress"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "title": "Total Cards Generated",
      "type": "stat",
      "gridPos": { "x": 6, "y": 24, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(echovault_cards_generated_total{job=\"echovault-backend\"})",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 9,
      "title": "LLM Error Rate",
      "type": "stat",
      "gridPos": { "x": 12, "y": 24, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(echovault_llm_errors_total{job=\"echovault-backend\"}[5m]))",
          "legendFormat": "errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "fixedColor": "red", "mode": "fixed" } }
      }
    },
    {
      "id": 10,
      "title": "Card Acceptance Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(echovault_cards_accepted_total{job=\"echovault-backend\"}[5m]) / (rate(echovault_cards_accepted_total{job=\"echovault-backend\"}[5m]) + rate(echovault_cards_rejected_total{job=\"echovault-backend\"}[5m]))",
          "legendFormat": "acceptance rate"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 11,
      "title": "Staging Decisions",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(echovault_cards_accepted_total{job=\"echovault-backend\"}[5m])",
          "legendFormat": "accepted/s"
        },
        {
          "expr": "rate(echovault_cards_rejected_total{job=\"echovault-backend\"}[5m])",
          "legendFormat": "rejected/s"
        },
        {
          "expr": "rate(echovault_cards_edited_total{job=\"echovault-backend\"}[5m])",
          "legendFormat": "edited/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 12,
      "title": "Total Accepted",
      "type": "stat",
      "gridPos": { "x": 0, "y": 36, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(echovault_cards_accepted_total{job=\"echovault-backend\"})",
          "legendFormat": "accepted"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "green", "mode": "fixed" } } }
    },
    {
      "id": 13,
      "title": "Total Rejected",
      "type": "stat",
      "gridPos": { "x": 4, "y": 36, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(echovault_cards_rejected_total{job=\"echovault-backend\"})",
          "legendFormat": "rejected"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "red", "mode": "fixed" } } }
    },
    {
      "id": 14,
      "title": "Total Edited",
      "type": "stat",
      "gridPos": { "x": 8, "y": 36, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(echovault_cards_edited_total{job=\"echovault-backend\"})",
          "legendFormat": "edited"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "orange", "mode": "fixed" } } }
    }
  ]
}
