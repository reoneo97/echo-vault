OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_MODEL=qwen/qwen3-32b

# Path to the vault's EchoVault/ directory (for card store + manifest)
ECHOVAULT_STORE_PATH=/path/to/vault/EchoVault

# Agent pipeline — critic uses a different model family than the generator
# Generator: qwen/qwen3-32b (strong 32B dense, quality generation)
# Critic:    deepseek/deepseek-v4-flash (different family, fast review)
CRITIC_MODEL=deepseek/deepseek-v4-flash

# MLflow tracking server — reachable via Tailscale
MLFLOW_TRACKING_URI=http://mlflow.reoneo.dev
MLFLOW_EXPERIMENT_NAME=echovault

ENVIRONMENT=development
